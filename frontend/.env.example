# The API occupies port 3000 locally, so run Next.js on port 3001.
BACKEND_INTERNAL_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DATABASE_PATH=.data/auth.db

OIDC_ISSUER=https://auth.example.com/application/o/portfolio/
OIDC_DISCOVERY_ADDRESS=https://auth.example.com/application/o/portfolio/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/
OIDC_SCOPE=openid profile email offline_access

# Public contact address shown by the portfolio.
NEXT_PUBLIC_CONTACT_EMAIL=me@joaoloureiro.dev.br
