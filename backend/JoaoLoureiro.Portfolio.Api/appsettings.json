{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContentStore": {
    "Path": "data/portfolio.db"
  },
  "SmtpTransport": {
    "Host": "smtp.example.invalid",
    "Port": 587,
    "SecurityMode": "StartTls",
    "AuthenticationRequired": true,
    "Username": "smtp-user-placeholder",
    "Password": "smtp-password-placeholder",
    "FromAddress": "no-reply@example.invalid",
    "ConnectTimeoutSeconds": 5,
    "SendTimeoutSeconds": 15,
    "DisconnectTimeoutSeconds": 5
  },
  "EmailDelivery": {
    "InitialEnabled": true,
    "InitialRecipientAddress": "me@joaoloureiro.dev.br",
    "InitialSenderDisplayName": "Portfolio contact",
    "InitialSubjectPrefix": "New Portfolio Contact"
  }
}
